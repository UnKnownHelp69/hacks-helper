# Copy this file to .env and fill in real values. NEVER commit .env.
# Скопируйте файл в .env и заполните. .env НИКОГДА не коммитить.

# --- Telegram ---
# Bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token

# Exactly ONE negative group/supergroup chat id (for example -100...).
# Positive private chat ids and multiple groups are rejected.
# Empty = disabled: no commands, callbacks or notifications in any chat.
# Ровно один отрицательный id группы; личка отключена без исключений.
ALLOWED_CHAT_IDS=

# Telegram user_ids of bot admins, comma separated. /me works only inside the allowed group.
# Права админа группы в Telegram сюда НЕ относятся.
BOT_ADMIN_IDS=

# --- GitHub ---
# Fine-grained personal access token (only selected repositories):
#   Metadata: Read-only, Issues: Read and write, Pull requests: Read-only.
# Empty = GitHub features are disabled.
GITHUB_TOKEN=
# How often to poll GitHub for task statuses, minutes
GITHUB_POLL_INTERVAL_MINUTES=10
# Label that marks an issue as "in progress"
GITHUB_IN_PROGRESS_LABEL=in progress

# --- Hackathon import via LLM (optional) ---
# Default provider: openrouter (also compatible APIs) or gigachat.
# Each user can change their selection in /me → Модель нейросети.
LLM_PROVIDER=openrouter
# OpenRouter / compatible API key.
LLM_API_KEY=
# Free router supporting structured output; availability/rate limits may vary.
# Set another model id explicitly if desired (paid models use your API balance).
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1

# GigaChat: Authorization key from the developer account (base64 client_id:secret).
# Paste the key as issued; do not include the "Basic " prefix.
# Empty = GigaChat is unavailable; OpenRouter can still be used independently.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Optional PEM bundle with official CA certificates if system trust is insufficient.
# Get certificates via the official GigaChat documentation; TLS stays verified.
GIGACHAT_CA_BUNDLE_FILE=

# --- Reminders ---
# Hours before each date (registration end, start, end) to ping participants
REMINDER_OFFSETS_HOURS=24,3,1
# Default chat time zone (IANA name)
DEFAULT_TIMEZONE=Europe/Moscow

# --- Storage and logs ---
DATABASE_PATH=data/bot.db
# Empty = log to console only
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
# How long getChatMember results (current usernames, membership) are cached, seconds
USER_CACHE_TTL_SECONDS=300
